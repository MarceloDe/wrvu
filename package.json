{
  "name": "neurorvu",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib scripts tests middleware.js --ext .js,.jsx,.ts,.tsx,.mjs --max-warnings=0",
    "db:studio": "drizzle-kit studio",
    "test:redaction": "node scripts/test/redaction.test.mjs",
    "test:forged-attachment": "node scripts/test/forged-attachment.test.mjs",
    "test:llm-proxy-contract": "node scripts/test/llm-proxy-contract.mjs",
    "verify:redaction": "node scripts/test/redaction.test.mjs && node scripts/verify/redaction-e2e.mjs && node scripts/verify/no-unredacted-path.mjs && node scripts/verify/phi-log-scan.mjs --stream captured-session.log",
    "test:error-envelope": "node --test tests/error-envelope.test.ts",
    "test:route-contracts": "node --test tests/route-contracts.test.mjs",
    "verify:shippable": "node scripts/verify/shippable.mjs",
    "db:migrate": "node --env-file=.env.local lib/db/migrate.mjs --url-env DATABASE_URL_UNPOOLED",
    "db:migrate:check": "node --env-file=.env.local lib/db/migrate.mjs --url-env DATABASE_URL_UNPOOLED --check",
    "test:baseline": "node --test tests/baseline-consolidation.test.mjs",
    "test:analytics": "node --test tests/analytics-extraction.test.mjs",
    "test:extra-duty": "node --test tests/extra-duty.test.mjs",
    "test:comp-display": "node --test tests/comp-display.test.mjs",
    "test:onboarding-skip": "node scripts/verify/onboarding-skip.mjs",
    "test:search": "node --test tests/search.test.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^5.7.5",
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.36.4",
    "lucide-react": "0.383.0",
    "next": "14.2.5",
    "pg": "^8.23.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "10.4.19",
    "drizzle-kit": "^0.28.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "playwright-core": "^1.62.1",
    "postcss": "8.4.40",
    "tailwindcss": "3.4.7",
    "typescript": "^5.9.3",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  }
}
